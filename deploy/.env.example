# Copy to pnk-mail/.env before `docker compose up`
# Generate secrets: openssl rand -hex 32

POSTGRES_USER=pnk
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_PORT=5432

JWT_SECRET=change-me-jwt-min-32-chars-xxxxxxxxxxxx
SESSION_SECRET=change-me-session-min-32-chars-xxxxxxx
PNK_ID_CLIENT_SECRET=change-me-oauth-client-secret-xxxx
MAIL_VAULT_SECRET=change-me-vault-hmac-min-32-chars-xx

APP_URL=https://id.pnkmail.ru
NEXT_PUBLIC_PNK_ID_URL=https://id.pnkmail.ru
NEXT_PUBLIC_MAIL_URL=https://pnkmail.ru

MAIL_TRANSPORT=console
MAIL_FROM_DOMAIN=pnkmail.ru
# RESEND_API_KEY=re_xxx
# or SES_*

ID_PORT=3100
MAIL_PORT=3000

# Optional: demo user password after seed (default password123)
# SEED_DEMO_PASSWORD=
