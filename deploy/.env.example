# =============================================================================
# /opt/pnk/pnk-mail/.env  — один файл на весь стек (compose читает его отсюда)
# Секреты:  openssl rand -hex 32
# НЕ коммитьте этот файл.
# =============================================================================

# --- Postgres (один сервер, две БД: pnk_id + pnk_mail) ---
POSTGRES_USER=pnk
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
# Пароль без спецсимволов @:#/? — иначе ломается DATABASE_URL в compose
POSTGRES_PORT=5432

# --- Секреты приложений (все разные, по 64 hex-символа) ---
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
SESSION_SECRET=REPLACE_WITH_openssl_rand_hex_32
PNK_ID_CLIENT_SECRET=REPLACE_WITH_openssl_rand_hex_32
MAIL_VAULT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# --- Публичные URL (HTTPS). Обязательно ваши реальные домены ---
# Эти же значения уходят в Docker BUILD (NEXT_PUBLIC_*), иначе в браузере будет localhost
APP_URL=https://id.pnkmail.ru
NEXT_PUBLIC_PNK_ID_URL=https://id.pnkmail.ru
NEXT_PUBLIC_MAIL_URL=https://pnkmail.ru

# --- Исходящая почта ---
MAIL_TRANSPORT=console
MAIL_FROM_DOMAIN=pnkmail.ru
# MAIL_TRANSPORT=resend
# RESEND_API_KEY=re_xxx
# MAIL_TRANSPORT=ses
# SES_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
# SES_SMTP_PORT=587
# SES_SMTP_USER=
# SES_SMTP_PASS=

ID_PORT=3100
MAIL_PORT=3000

# SEED_DEMO_PASSWORD=
