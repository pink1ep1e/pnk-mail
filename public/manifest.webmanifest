{
  "id": "/",
  "name": "pnk Почта",
  "short_name": "pnk Почта",
  "description": "Быстрая и защищённая почта pnk",
  "start_url": "/mail",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#0c0d10",
  "theme_color": "#0c0d10",
  "lang": "ru",
  "dir": "ltr",
  "categories": ["productivity", "social"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
