# Database — PostgreSQL (local Docker or remote)
DATABASE_URL="postgresql://pnk:pnk@localhost:5432/pnk_mail?schema=public"

# pnk ID OAuth
NEXT_PUBLIC_PNK_ID_URL="http://localhost:3100"
# Server-side token exchange (VPS): avoid nginx hairpin → 502 on login
# PNK_ID_INTERNAL_URL="http://127.0.0.1:3100"
NEXT_PUBLIC_MAIL_URL="http://localhost:3000"

# SEO — verification codes from Search Console / Webmaster
# GOOGLE_SITE_VERIFICATION=""
# YANDEX_VERIFICATION=""

PNK_ID_CLIENT_SECRET="pnk-mail-dev-secret"
MAIL_VAULT_SECRET="dev-mail-vault-secret-min-32-chars!!"

# Outbound + inbound (Resend recommended)
MAIL_TRANSPORT="console"
MAIL_FROM_DOMAIN="pnkmail.ru"

# MAIL_TRANSPORT="resend"
# RESEND_API_KEY="re_xxx"
# Shared secret for https://pnkmail.ru/api/mail/inbound (Resend email.received webhook)
# MAIL_INBOUND_SECRET="openssl_rand_hex_32"

# Web Push (PWA notifications) — generate once:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY="B...."
# VAPID_PRIVATE_KEY="...."
# VAPID_SUBJECT="mailto:support@pnkmail.ru"

# MAIL_TRANSPORT="ses"
# SES_SMTP_HOST="email-smtp.eu-central-1.amazonaws.com"
# SES_SMTP_PORT="587"
# SES_SMTP_USER=""
# SES_SMTP_PASS=""
