# Database — PostgreSQL (local Docker or remote)
DATABASE_URL="postgresql://pnk:pnk@localhost:5432/pnk_mail?schema=public"

# pnk ID OAuth
NEXT_PUBLIC_PNK_ID_URL="http://localhost:3100"
NEXT_PUBLIC_MAIL_URL="http://localhost:3000"
PNK_ID_CLIENT_SECRET="pnk-mail-dev-secret"
MAIL_VAULT_SECRET="dev-mail-vault-secret-min-32-chars!!"

# Outbound mail: console | resend | ses
MAIL_TRANSPORT="console"
MAIL_FROM_DOMAIN="pnkmail.ru"

