// pnk-mail — mailbox store (PostgreSQL in production / Docker)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mailbox {
  id          String             @id @default(cuid())
  ownerUserId String
  address     String             @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  messages    Message[]
  folders     MailFolder[]
  labels      MailLabel[]
  pushSubs    PushSubscription[]

  @@index([ownerUserId])
}

model Message {
  id             String    @id @default(cuid())
  mailboxId      String
  mailbox        Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  folder         String
  fromName       String
  fromEmail      String
  toAddresses    String
  ccAddresses    String    @default("")
  subject        String
  preview        String
  bodyHtml       String    @default("")
  bodyText       String    @default("")
  /// Logo URL extracted from branded HTML (or null → resolve from domain at read time)
  senderLogoUrl  String?
  unread         Boolean   @default(true)
  hasAttachment  Boolean   @default(false)
  /// JSON array of MailLabel ids
  labelIds       String    @default("[]")
  remindAt       DateTime?
  /// Conversation id — shared across replies in one thread
  threadId       String?
  /// RFC Message-ID of this message (for dedup + In-Reply-To matching)
  rfcMessageId   String?
  /// RFC In-Reply-To header value (normalized, no brackets)
  inReplyTo      String?
  /// Resend (or other) provider message id for outbound tracking
  providerId     String?
  /// queued | sent | delivered | delayed | bounced | failed | complained | suppressed
  deliveryStatus String?
  deliveryDetail String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([mailboxId, folder, createdAt])
  @@index([mailboxId, unread])
  @@index([mailboxId, threadId, createdAt])
  @@index([mailboxId, rfcMessageId])
  @@index([providerId])
}

model MailFolder {
  id        String   @id @default(cuid())
  mailboxId String
  mailbox   Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([mailboxId, name])
  @@index([mailboxId])
}

model MailLabel {
  id        String   @id @default(cuid())
  mailboxId String
  mailbox   Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#4d9fff")
  createdAt DateTime @default(now())

  @@unique([mailboxId, name])
  @@index([mailboxId])
}

/// Web Push subscription for PWA mail notifications
model PushSubscription {
  id        String   @id @default(cuid())
  mailboxId String
  mailbox   Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mailboxId])
}
